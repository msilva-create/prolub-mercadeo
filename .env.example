# =============================================
# PROLUB - FONDO DE MERCADEO
# Variables de entorno — copiar a .env.local
# =============================================

# --- SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# --- SMTP (Nodemailer) ---
# Para Gmail: activa "contraseñas de aplicación" en tu cuenta Google
#   Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de app
# Para Outlook/Office365: usa smtp.office365.com puerto 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@prolub.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# --- DESTINATARIOS FIJOS ---
EMAIL_ADMIN=tu_correo@prolub.com
EMAIL_JEFE=jefe@prolub.com
# El comercial se asigna por distribuidor en Supabase (campo correo_comercial)
